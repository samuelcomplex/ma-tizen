<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://github.com/samuelcomplex/ma-tizen" version="@VERSION@" viewmodes="maximized">
    <tizen:application id="MaTvSendsp.MusicAssistantTV" package="MaTvSendsp" required_version="3.0"/>
    <name>Music Assistant TV</name>
    <description>Now playing, karaoke lyrics, party mode and a synced Sendspin speaker for Music Assistant.</description>
    <author href="https://github.com/samuelcomplex/ma-tizen">ma-tizen contributors</author>
    <license href="https://www.apache.org/licenses/LICENSE-2.0">Apache License 2.0</license>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <access origin="*" subdomains="true"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
    <tizen:content-security-policy>default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; connect-src * ws: wss: http: https:; img-src * data: blob: http: https:; media-src * blob: data:</tizen:content-security-policy>
</widget>
